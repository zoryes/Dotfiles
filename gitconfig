[user]
	name = Alexandru Cuta

[alias]
  st = status
  a = add 
  cm = commit -m 
  cam = commit -am 
  d = diff 
  dc = diff --cached 
  p = push 
  l = pull

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[merge]
    conflictStyle = zdiff3
